# /etc/quotes-scraper.env — read by quotes-scraper.service.
# Credentials come from the EC2 instance profile (quotes-ec2-scraper-role);
# never put AWS access keys in this file.

# sqs = phase 6 pipeline (default) | s3 = legacy raw/ bucket path
SCRAPER_OUTPUT=sqs
QUEUE_URL=https://sqs.eu-north-1.amazonaws.com/<ACCOUNT_ID>/quotes-ingest-queue
AWS_DEFAULT_REGION=eu-north-1

# Only needed when SCRAPER_OUTPUT=s3
# RAW_BUCKET=sadi-quotes-bucket
